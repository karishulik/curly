<script>
(function () {
'use strict';
var seconds = 5;
var downloadUrl = "https:\/\/befonts.com\/downfile?post_id=584673&post_slug=nauryzredkeds-font&token=qKbYjJlXtzIWQDvVA2KM0EqkQmg1j8Mh&pf_nonce=39ae7e3997";
var interval = null;
var downloadBox = document.querySelector('.downloading-box');
var countElement = downloadBox
? downloadBox.querySelector('.count')
: null;
var manualButton = document.getElementById('pxfManualDownload');
/*
* Dùng iframe ẩn để tải file mà không rời khỏi trang download.
*/
function startDownload() {
if (!downloadUrl) {
console.warn('No valid download URL.');
return;
}
var iframe = document.createElement('iframe');
iframe.style.display = 'none';
iframe.setAttribute('aria-hidden', 'true');
iframe.src = downloadUrl;
document.body.appendChild(iframe);
/*
* Giữ iframe đủ lâu để server xử lý redirect/download,
* sau đó dọn khỏi DOM.
*/
window.setTimeout(function () {
if (iframe.parentNode) {
iframe.parentNode.removeChild(iframe);
}
}, 60000);
}
if (manualButton) {
manualButton.addEventListener('click', function () {
if (interval) {
window.clearInterval(interval);
interval = null;
}
startDownload();
});
}
interval = window.setInterval(function () {
seconds--;
if (seconds < 0) {
seconds = 0;
}
if (countElement) {
countElement.textContent = seconds;
}
if (seconds <= 0) {
window.clearInterval(interval);
interval = null;
startDownload();
}
}, 1000);
})();
</script>
